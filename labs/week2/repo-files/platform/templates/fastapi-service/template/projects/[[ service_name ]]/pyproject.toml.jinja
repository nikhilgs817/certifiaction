[project]
name = "[[ service_name ]]"
version = "0.1.0"
description = "[[ description ]]"
requires-python = ">=3.14,<3.15"
dependencies = [
  "fastapi==0.162.0",
  "uvicorn==0.54.0",
  "pydantic==2.14.2",
  "pydantic-settings==2.16.2",
  "prometheus-client==0.26.0",
]

[dependency-groups]
dev = [
  "pytest==9.2.0",
  "httpx2==2.16.0",                  # Starlette TestClient transport (httpx is deprecated there)
  "ruff==0.17.3",
  "mypy==2.4.1",
]

[tool.uv]
package = false                     # an app, not a library: uv installs dependencies only

[tool.ruff]
line-length = 120
target-version = "py314"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "S", "ASYNC"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]               # assert is how pytest works

[tool.mypy]
strict = true
files = ["app"]
plugins = ["pydantic.mypy"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]                  # import `app` from the project root
addopts = "-q"
